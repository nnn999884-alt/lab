# .env 로 복사 후 값 입력 (절대 커밋 금지)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# accountSeq: python -m pennybot accounts 로 확인
TOSS_ACCOUNT=
# SEC 공시 조회용 (SEC 정책상 이름+연락처 필수), 예: pennybot Hong me@example.com
SEC_USER_AGENT=
# 체결·청산 알림 (디스코드/슬랙 웹훅 URL, 선택)
PENNYBOT_WEBHOOK=
# 텔레그램 알림 + 휴대폰 원격 제어 (선택): @BotFather 에서 받은 토큰, chat id 는 pennybot telegram-setup 으로 확인
PENNYBOT_TELEGRAM_TOKEN=
PENNYBOT_TELEGRAM_CHAT=
# 실거래 시에만: YES
PENNYBOT_LIVE_CONFIRM=
# 대시보드 비밀번호 (외부 주소 tunnel.bat 을 쓸 때 필수, 아이디는 아무거나)
PENNYBOT_DASHBOARD_PASSWORD=
